# Server only. Never prefix secrets with VITE_.
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Supabase secret key (sb_secret_...) or legacy service_role key. NOT anon.
SUPABASE_SECRET_KEY=
DEMO_USER_ID=11111111-1111-4111-8111-111111111111
# Choose agent-platform for your real system, or gemini for direct demo support.
CHAT_PROVIDER=agent-platform
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Full endpoints in YOUR real Agent Platform. Both use the adapter in server/agent.mjs.
AGENT_CHAT_URL=
AGENT_CONSENT_URL=
AGENT_API_KEY=
# Sent server-to-server, never accepted from the browser.
AGENT_TENANT_ID=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Configure this same secret as the tool credential in your real Agent Platform.
TOOL_API_KEY=
AGENT_TIMEOUT_MS=60000
