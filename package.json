{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "user:password": "node --env-file-if-exists=.env scripts/set-user-password.mjs",
    "check:db": "node --env-file-if-exists=.env scripts/check-db.mjs",
    "check:chat": "node --env-file-if-exists=.env scripts/check-chat.mjs",
    "dev": "vite",
    "dev:api": "node --watch --env-file-if-exists=.env server/index.mjs",
    "start:api": "node --env-file-if-exists=.env server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 server/tests/*.test.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.54.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "^7.3.7"
  }
}
